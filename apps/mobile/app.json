{
  "expo": {
    "name": "Clear Accounts",
    "slug": "clear-accounts",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.clearaccounts"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E9F6E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.clearaccounts"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "clearaccounts",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "61165cd3-5771-4ce1-b836-319a210b5c0a"
      }
    },
    "owner": "alnama-llc",
    "updates": {
      "url": "https://u.expo.dev/61165cd3-5771-4ce1-b836-319a210b5c0a"
    }
  }
}
